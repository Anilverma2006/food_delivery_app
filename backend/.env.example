# MongoDB Atlas connection string
DATABASEURL=

# Use a long, randomly generated value in production
JWT_SECRET=

# Stripe test/live secret key
STRIPE_SECRET_KEY=

# Cloudinary image storage credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Frontend URL used by Stripe redirect URLs
FRONTEND_URL=http://localhost:5173
